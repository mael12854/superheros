# Jeton du store Vercel Blob (créé en accès PRIVÉ). Ajouté automatiquement par Vercel quand on relie le store.
BLOB_READ_WRITE_TOKEN=
# Clé secrète pour signer les sessions des chefs (au moins 32 caractères au hasard).
SESSION_SECRET=
# Code admin (chiffres) : ouvre tous les outils chef et sert à installer le QG. Ne jamais l'écrire dans le code.
CODE_ADMIN=
